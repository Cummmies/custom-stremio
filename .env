# The hosted tracker, for every build: release (vite build) and development
# (npm run dev, tauri dev). Not a secret: every install talks to it. Tests
# override it (.env.lbtest).
VITE_TRACKER_SERVER=https://tracker-stremio.duckdns.org
# The same server by its home-network name, used when the address above
# doesn't answer from inside the home network (lib/tracker.svelte.ts).
VITE_TRACKER_HOME_SERVER=https://tracker-stremio-home.duckdns.org
