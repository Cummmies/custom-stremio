{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Custom Stremio",
  "version": "0.1.0",
  "identifier": "com.sdola.customstremio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Stremio - Freedom to Stream",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "theme": "Dark",
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "server/*",
      "lib/*"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": []
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE1OEEyQjBFQ0Q5QTk1NTcKUldSWGxack5EaXVLcGVCejA3L3RCd2I3bDV3Z2xPTFdMeWFQTm5Xbk4vNnFWTWJSaVFvWlorV2oK",
      "endpoints": [
        "https://github.com/Cummmies/custom-stremio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
