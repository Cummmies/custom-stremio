<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Some addons and debrid services hand out plain http:// stream links. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
    <!-- iOS asks before the app reaches devices on your home network: here, your
         server (on the local network or at a LAN address). Asked only when
         you connect one in Settings (docs/tracker.md). -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Stremio connects to your server on your home network to sync what you watch.</string>
    <!-- Keep the sound going when the screen locks or you switch apps. -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>
    <!-- Portrait for browsing; the player locks itself to landscape. -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UIRequiresFullScreen</key>
    <false/>
</dict>
</plist>
